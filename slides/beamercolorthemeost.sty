\mode<presentation>

\RequirePackage[table]{xcolor}

\definecolor{subtitles}{HTML}{bfbfbf}
\definecolor{frametitles}{HTML}{ffffff}
\definecolor{framesubtitles}{HTML}{bfbfbf}

% Settings
\setbeamercolor*{title page header}{fg=white}
\setbeamercolor*{title page subheader}{fg=white}
\setbeamercolor*{author}{fg=subtitles}
\setbeamercolor*{date}{fg=subtitles}
\setbeamercolor*{default page}{bg=white}
\setbeamercolor*{blank page}{}

\setbeamercolor*{item}{fg=darkgray}

\setbeamercolor*{block title}{fg=darkgray,bg=lightgray}
\setbeamercolor*{block body}{fg=black,bg=lightgray}

\setbeamercolor*{frame title left}{bg=lightgray}
\setbeamercolor*{frame title main}{fg=frametitles, bg=darkgray}
\setbeamercolor*{frame title sub}{fg=framesubtitles}

\mode<all>